# Casper Via CTA-E07-14A (Meson6) — merged onto allnoconfig.
# Budget: uImage (kernel + dtb + initramfs) must fit the 8 MiB recovery partition.
CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_MESON=y
CONFIG_MACH_MESON6=y
# Meson6 CPU1 bring-up: patches/0006 (amlogic,meson6-smp)
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_HIGHMEM=y
CONFIG_VFP=y
CONFIG_NEON=y
CONFIG_AEABI=y
CONFIG_KERNEL_XZ=y
CONFIG_ARM_APPENDED_DTB=y
CONFIG_CMDLINE="console=ttyAML0,115200 console=tty0 panic=0 loglevel=8 ignore_loglevel"
CONFIG_CMDLINE_FORCE=y

CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_PANIC_TIMEOUT=0
CONFIG_MULTIUSER=y
CONFIG_SHMEM=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="@TOP@/build/initramfs.list"
CONFIG_INITRAMFS_COMPRESSION_NONE=y

# serial (UART_AO is what stock uses as ttyS0)
CONFIG_TTY=y
CONFIG_SERIAL_MESON=y
CONFIG_SERIAL_MESON_CONSOLE=y

# screen: reuse the framebuffer the bootloader lit up for the logo
CONFIG_FB=y
# simpledrm (DRM/KMS for Weston) instead of simplefb; fbcon via fbdev emulation
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y

# crash log survives warm reboot; Android reads it back via /dev/mem
CONFIG_MISC_FILESYSTEMS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y

# reboot + i2c + PMIC
CONFIG_WATCHDOG=y
CONFIG_MESON_WATCHDOG=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MESON=y
CONFIG_MFD_AXP20X_I2C=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_POWER_SUPPLY=y
CONFIG_IIO=y
CONFIG_AXP20X_ADC=y
CONFIG_BATTERY_AXP20X=y
CONFIG_AXP20X_POWER=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_AXP20X_PEK=y

# bring-up: init pokes pinmux copied from stock (no Meson6 pinctrl driver yet)
CONFIG_DEVMEM=y

# touch (own driver, polled) + accelerometer on the IRQ-less i2c_B
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GT811=y
CONFIG_MMA8452=y

# dev loop over the OTG cable: serial gadget shell (tools/tablet.py)
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_G_SERIAL=y

# debugging over the USB shell: echo w > /proc/sysrq-trigger, cat /proc/<pid>/stack
CONFIG_MAGIC_SYSRQ=y
CONFIG_STACKTRACE=y

# busybox (musl 1.1, 2019) still calls the time32 syscalls; without this nanosleep is
# ENOSYS and sleep/timeout/read -t return instantly or hang.
CONFIG_COMPAT_32BIT_TIME=y

# accel/battery/SD/Wi-Fi round
CONFIG_USB=y
CONFIG_BLOCK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MESON_MX_SDIO=y
CONFIG_EXT4_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_NETDEVICES=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=y
CONFIG_FW_LOADER=y
CONFIG_EXTRA_FIRMWARE="mt7601u.bin"
CONFIG_EXTRA_FIRMWARE_DIR="@TOP@/kernel/firmware"
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# backlight + runtime PM + what udev/libinput/Weston expect from the kernel
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_MESON6_LED_PWM=y
CONFIG_PM=y
CONFIG_INOTIFY_USER=y
CONFIG_SYSVIPC=y
CONFIG_UNIX98_PTYS=y
