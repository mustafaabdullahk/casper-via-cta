diff --git a/drivers/video/backlight/meson6_led_pwm_bl.c b/drivers/video/backlight/meson6_led_pwm_bl.c
new file mode 100644
index 000000000..5b255d50b
--- /dev/null
+++ b/drivers/video/backlight/meson6_led_pwm_bl.c
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Backlight on the Meson6 "LED PWM" block (Casper Via CTA-E07-14A).
+ *
+ * The panel backlight is not on the general PWMs: stock Android's aml-bl only ever
+ * changed bits 3:0 of LED_PWM_REG2 (0xc1108768). 0x0 is brightest; stock never went
+ * past 0xd, so that is the dimmest level exposed here.
+ */
+
+#include <linux/backlight.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#define MESON6_BL_LEVEL_MASK	0xf
+#define MESON6_BL_DIMMEST	0xd	/* stock aml-bl clamps here */
+
+struct meson6_bl {
+	void __iomem *reg;
+};
+
+static int meson6_bl_update_status(struct backlight_device *bl)
+{
+	struct meson6_bl *priv = bl_get_data(bl);
+	int level = backlight_get_brightness(bl);
+	u32 val = readl(priv->reg) & ~MESON6_BL_LEVEL_MASK;
+
+	/* ponytail: "off" is the dimmest stock level; the panel-off control is not mapped yet */
+	writel(val | (MESON6_BL_DIMMEST - level), priv->reg);
+	return 0;
+}
+
+static const struct backlight_ops meson6_bl_ops = {
+	.update_status = meson6_bl_update_status,
+};
+
+static int meson6_bl_probe(struct platform_device *pdev)
+{
+	struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.max_brightness = MESON6_BL_DIMMEST,
+	};
+	struct backlight_device *bl;
+	struct meson6_bl *priv;
+
+	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->reg = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(priv->reg))
+		return PTR_ERR(priv->reg);
+
+	/* start from what the bootloader set */
+	props.brightness = MESON6_BL_DIMMEST -
+		min_t(u32, readl(priv->reg) & MESON6_BL_LEVEL_MASK, MESON6_BL_DIMMEST);
+
+	bl = devm_backlight_device_register(&pdev->dev, dev_name(&pdev->dev), &pdev->dev,
+					    priv, &meson6_bl_ops, &props);
+	return PTR_ERR_OR_ZERO(bl);
+}
+
+static const struct of_device_id meson6_bl_of_match[] = {
+	{ .compatible = "amlogic,meson6-led-pwm-backlight" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, meson6_bl_of_match);
+
+static struct platform_driver meson6_bl_driver = {
+	.probe = meson6_bl_probe,
+	.driver = {
+		.name = "meson6-led-pwm-bl",
+		.of_match_table = meson6_bl_of_match,
+	},
+};
+module_platform_driver(meson6_bl_driver);
+
+MODULE_DESCRIPTION("Meson6 LED PWM backlight");
+MODULE_LICENSE("GPL");
