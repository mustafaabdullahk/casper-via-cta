index 32ac60b89..f8d1ed60a 100644
--- a/arch/arm/mach-meson/platsmp.c
+++ b/arch/arm/mach-meson/platsmp.c
@@ -410,6 +410,48 @@ static int meson8b_smp_cpu_kill(unsigned int cpu)
 }
 #endif
 
+/*
+ * Meson6 (AML8726-MX): no PMU power/reset sequence. The bootloader leaves CPU1 powered in a
+ * boot ROM loop that polls the same SRAM mailbox as Meson8 (stock 3.0.8 leaves
+ * CTRL = 0x3, ADDR = its secondary_startup), so publishing the entry point and the
+ * enable bit, then waking it with SEV, is enough.
+ */
+static void __init meson6_smp_prepare_cpus(unsigned int max_cpus)
+{
+	struct device_node *node;
+
+	node = of_find_compatible_node(NULL, NULL, "amlogic,meson6-smp-sram");
+	sram_base = node ? of_iomap(node, 0) : NULL;
+	of_node_put(node);
+
+	node = of_find_compatible_node(NULL, NULL, "arm,cortex-a9-scu");
+	scu_base = node ? of_iomap(node, 0) : NULL;
+	of_node_put(node);
+
+	if (!sram_base || !scu_base) {
+		pr_err("meson6-smp: missing SRAM or SCU node\n");
+		return;
+	}
+	scu_enable(scu_base);
+}
+
+static int meson6_smp_boot_secondary(unsigned int cpu, struct task_struct *idle)
+{
+	if (!sram_base || !scu_base)
+		return -ENODEV;
+
+	meson_smp_begin_secondary_boot(cpu);
+	meson_smp_set_cpu_ctrl(cpu, true);
+	dsb_sev();
+
+	return 0;
+}
+
+static struct smp_operations meson6_smp_ops __initdata = {
+	.smp_prepare_cpus	= meson6_smp_prepare_cpus,
+	.smp_boot_secondary	= meson6_smp_boot_secondary,
+};
+
 static struct smp_operations meson8_smp_ops __initdata = {
 	.smp_prepare_cpus	= meson8_smp_prepare_cpus,
 	.smp_boot_secondary	= meson8_smp_boot_secondary,
@@ -428,5 +470,6 @@ static struct smp_operations meson8b_smp_ops __initdata = {
 #endif
 };
 
+CPU_METHOD_OF_DECLARE(meson6_smp, "amlogic,meson6-smp", &meson6_smp_ops);
 CPU_METHOD_OF_DECLARE(meson8_smp, "amlogic,meson8-smp", &meson8_smp_ops);
 CPU_METHOD_OF_DECLARE(meson8b_smp, "amlogic,meson8b-smp", &meson8b_smp_ops);
