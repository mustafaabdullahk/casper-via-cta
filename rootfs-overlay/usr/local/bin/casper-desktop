#!/bin/sh
# Touch desktop for the Casper Via: udev (libinput) + seatd + labwc (pixman, no GPU),
# with waybar (launchers, keyboard toggle) and wvkbd from ~/.config/labwc/autostart.
# /init starts us with PATH=/bin only
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export XDG_RUNTIME_DIR=/run/xdg HOME=/root
export WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1 LIBSEAT_BACKEND=seatd
mkdir -p -m 700 $XDG_RUNTIME_DIR
pgrep udevd >/dev/null || { udevd --daemon; udevadm trigger; udevadm settle -t 5; }
pgrep seatd >/dev/null || { seatd -g root >/var/log/seatd.log 2>&1 & sleep 1; }
exec dbus-run-session labwc >/var/log/labwc.log 2>&1
